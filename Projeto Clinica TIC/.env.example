# ============================================
# Sistema de Estoque Inteligente
# Arquivo de Configuração de Ambiente
# Copie este arquivo para .env e ajuste os valores
# ============================================

# BANCO DE DADOS (MariaDB)
DB_ROOT_PASSWORD=root_password_123
DB_NAME=estoque_db
DB_USER=estoque_user
DB_PASSWORD=estoque_password_123

# CAMINHOS (VOLUMES DOCKER)
# Ajustar conforme ambiente (dev vs. produção)
PATH_DATABASE=/home/dev/estoque_db
PATH_FOTOS=/home/dev/fotos_produtos

# FLASK
FLASK_ENV=development
SECRET_KEY=sua_chave_secreta_super_segura_trocar_em_producao

# API ALEXA
ALEXA_API_KEY=alexa_api_key_trocar_em_producao

# MQTT (Eclipse Mosquitto)
MQTT_BROKER_HOST=broker
MQTT_BROKER_PORT=1883
